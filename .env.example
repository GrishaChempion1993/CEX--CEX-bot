# CEX-CEX: парсер + отдельный торговый сервис. Заполните свои Telegram-поля.
# Реальные ключи хранить только в локальном .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CEX_SPREAD_TELEGRAM_BOT_TOKEN=
CEX_SPREAD_TELEGRAM_CHAT_ID=
CEX_SPREAD_TRADER_TELEGRAM_BOT_TOKEN=
CEX_SPREAD_TRADER_TELEGRAM_CHAT_ID=

# Исходные флаги. Точки входа могут их не проверять: см. README.
# Для отключения трейдера не запускайте его процесс.
CEX_SPREAD_ENABLED=true
CEX_SPREAD_TRADER_ENABLED=false
CEX_SPREAD_TRADER_DRY_RUN=true

# Оба процесса должны использовать один отдельный Redis и один stream.
# Для live-режима используйте другую, чистую Redis DB / отдельный экземпляр.
REDIS_URL=redis://localhost:6379/0
CEX_SPREAD_REDIS_ENABLED=true
CEX_SPREAD_STREAM_KEY=cex_spread.signals
CEX_SPREAD_STREAM_MAXLEN=10000
CEX_SPREAD_TRADER_GROUP=cex_spread_trader

# 12 бирж с рыночными и торговыми адаптерами.
CEX_SPREAD_EXCHANGES=bybit,okx,gate,bitget,blofin,kucoin,htx,bingx,phemex,bitmart,coinex,lbank
CEX_SPREAD_TRADER_EXCHANGES=bybit,okx,gate,bitget,blofin,kucoin,htx,bingx,phemex,bitmart,coinex,lbank

# Парсер. Проценты спреда задаются числами: 3.0 = 3%.
CEX_SPREAD_MIN_SPREAD_OPEN_PCT=3.0
CEX_SPREAD_MIN_SPREAD_CLOSE_PCT=0.3
CEX_SPREAD_CLOSE_RATIO=0.80
CEX_SPREAD_MIN_VOLUME_USD=400000
CEX_SPREAD_MIN_BOOK_LIQUIDITY_USD=2000
CEX_SPREAD_MAX_DATA_AGE_SEC=10
CEX_SPREAD_POLL_INTERVAL_SEC=5
CEX_SPREAD_REGISTRY_REFRESH_SEC=3600
CEX_SPREAD_CONFIRM_ROUNDS=2
CEX_SPREAD_CONFIRM_DELAY_MS=1500
CEX_SPREAD_CONFIRM_CONCURRENCY=8
CEX_SPREAD_MAX_MEDIAN_DEVIATION_PCT=20
CEX_SPREAD_VENUE_ERROR_LIMIT=3
CEX_SPREAD_VENUE_COOLDOWN_SEC=300
CEX_SPREAD_MAX_SIGNAL_LIFETIME_SEC=1800
CEX_SPREAD_CACHE_ENABLED=true
CEX_SPREAD_CACHE_FILE=app/data/multi_exchange_tokens.json
CEX_SPREAD_LOG_LEVEL=INFO
CEX_SPREAD_LOG_FILE=

# Это dry-run ПАРСЕРА: true отключает и Telegram, и Redis-публикацию.
# Для симуляции сделок оставьте false и CEX_SPREAD_TRADER_DRY_RUN=true.
CEX_SPREAD_DRY_RUN=false

# Трейдер. Доли задаются дробями: 0.1 = 10%, 0.03 = 3%.
CEX_SPREAD_TRADER_POSITION_PCT=0.1
CEX_SPREAD_TRADER_MIN_USD=5.0
CEX_SPREAD_TRADER_LEVERAGE=1
CEX_SPREAD_TRADER_STOP_LOSS_ENABLED=true
CEX_SPREAD_TRADER_STOP_LOSS_PCT=0.03
CEX_SPREAD_TRADER_MIN_AVG_CLOSE_SEC=30
CEX_SPREAD_TRADER_MONITOR_SEC=10
CEX_SPREAD_TRADER_SLIPPAGE_PCT=0.002
CEX_SPREAD_TRADER_ORDER_TIMEOUT_SEC=300
CEX_SPREAD_TRADER_DRY_RUN_BALANCE_USD=1000
CEX_SPREAD_TRADER_DEFAULT_TAKER_FEE_PCT=0.0006
CEX_SPREAD_TRADER_FEE_OVERRIDES=
CEX_SPREAD_TRADER_LOG_LEVEL=INFO
CEX_SPREAD_TRADER_LOG_FILE=

# Для парсера и dry-run эти биржевые ключи не требуются.
# Заполняйте только ключи выбранных бирж для намеренного live-запуска.
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
GATE_API_KEY=
GATE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_PASSPHRASE=
BLOFIN_API_KEY=
BLOFIN_API_SECRET=
BLOFIN_PASSPHRASE=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_PASSPHRASE=
HTX_API_KEY=
HTX_API_SECRET=
BINGX_API_KEY=
BINGX_API_SECRET=
PHEMEX_API_KEY=
PHEMEX_API_SECRET=
BITMART_API_KEY=
BITMART_API_SECRET=
BITMART_MEMO=
COINEX_API_KEY=
COINEX_API_SECRET=
LBANK_API_KEY=
LBANK_API_SECRET=

# Общие настройки сети.
HTTP_TIMEOUT_SEC=8
PROXY_POOL=
RESEND_COOLDOWN_SEC=60

# Сохранённый MEXC-адаптер трейдера: вне стандартной связки из 12 бирж.
# В CEX-CEX парсере этой сборки MEXC не подключён.
MEXC_WEB_TOKEN=
MEXC_WEB_TOKEN_FILE=app/data/mexc_web_token.txt
MEXC_WEB_PROXY=
MEXC_WEB_REFRESH_ENABLED=false
MEXC_LOGIN_EMAIL=
MEXC_LOGIN_PASSWORD=
MEXC_TOTP_SECRET=
TRADER_LOG_HTTP=false
